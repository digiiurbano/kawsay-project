# ============================================================
#  KAWSAY — Variables de entorno (copia a .env o configúralas en Vercel)
# ============================================================

# --- Correo (elige UNA opción) -------------------------------
# Opción A: Resend (recomendado) — https://resend.com/api-keys
RESEND_API_KEY=

# Opción B: SMTP genérico (Gmail con "contraseña de aplicación", Brevo, Outlook, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx

# Remitente que verán los usuarios (el dominio debe estar verificado en tu proveedor)
EMAIL_FROM="KAWSAY Cultura <notificaciones@asoma.live>"

# --- Login con Google ----------------------------------------
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth (Aplicación web)
# Orígenes JavaScript autorizados: https://asoma.live, https://www.asoma.live, http://localhost:3005
GOOGLE_CLIENT_ID=
