{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/events/:id",
      "destination": "/api/events?id=:id"
    },
    {
      "source": "/api/spaces/:id",
      "destination": "/api/spaces?id=:id"
    },
    {
      "source": "/api/users/:id",
      "destination": "/api/users?id=:id"
    },
    {
      "source": "/api/interactions/:userId",
      "destination": "/api/interactions?userId=:userId"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
